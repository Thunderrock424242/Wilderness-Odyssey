{
  // WEBSITE DEPLOYMENT SETTINGS — edit this file, then commit your changes.
  // Only non-secret values belong here. Never add tokens, passwords, or keys.
  // Check your settings: npm run config:check -- --environment production
  // PUBLIC WEBSITE: only SITE_URL and CLOUDFLARE_PAGES_PROJECT are required.
  // Leave the backend/Access settings blank while STAFF_AUTH_MODE is disabled.
  // Order: shared -> production/preview -> nonempty environment variables.
  // Existing GitHub variables override values EXCEPT an explicit disabled staff
  // mode: edit this file to enable staff; old GitHub variables cannot enable it.
  "shared": {
    // Your canonical public website origin, e.g. https://www.example.com
    // No path, credentials, port, query, or fragment. Blank = local builds only.
    "SITE_URL": "https://wilderness-odyssey.pages.dev",

    // Cloudflare dashboard -> Workers & Pages -> your Pages project's name.
    // Use its exact lowercase name, e.g. wilderness-odyssey.
    "CLOUDFLARE_PAGES_PROJECT": "wilderness-odyssey",

    // "disabled" = public website first; staff/login routes remain unavailable.
    // Later: "discord" for Discord sign-in, or "access" for the Access flow.
    // Connected modes require the remaining settings and runtime secrets.
    "STAFF_AUTH_MODE": "disabled",

    // Your Discord SERVER ID, matching the backend's GUILD_ID.
    // Discord -> Settings -> Advanced -> Developer Mode. Then right-click
    // your server -> Copy Server ID. Keep the 17-22 digits inside quotes.
    "DISCORD_GUILD_ID": "1165859896407887902"
  },

  // LIVE WEBSITE — use approved production services here.
  "production": {
    // Registered Discord callback, e.g.
    // https://www.example.com/api/auth/discord/callback
    // Must use SITE_URL's origin. Leave blank until enabling Discord mode.
    "DISCORD_REDIRECT_URI": "",

    // Comma-separated staff hostnames, without https:// or paths.
    // Include your canonical host AND PROJECT.pages.dev. No wildcards.
    // Optional in disabled production; those two public hosts are added for you.
    "ALLOWED_HOSTS": "",

    // Cloudflare Zero Trust team origin, e.g. https://TEAM.cloudflareaccess.com
    // Leave blank for public-only production. Required for connected staff modes
    // and for serving protected previews to an authenticated verifier.
    "ACCESS_TEAM_DOMAIN": "",

    // Access application's Application Audience (AUD) Tag. Optional while disabled
    // in production; required with ACCESS_TEAM_DOMAIN for protected previews.
    "ACCESS_AUDIENCE": "",

    // Optional while staff is disabled. Blank = readable "not connected" status.
    // Sanitized public server-status HTTPS endpoint, including its path.
    // Do not use an administrative endpoint or add credentials to this URL.
    "PUBLIC_STATUS_URL": "",

    // Leave blank while disabled. Later: approved HTTPS backend origin only,
    // e.g. https://backend.example.com
    // No /v1 path, credentials, port, query, or fragment.
    "KINETIC_ADMIN_ORIGIN": ""
  },

  // STAGING WEBSITE — stays protected; not required to publish production first.
  // A preview deployment still needs its Access settings and verifier identity.
  // Add any shared key here (e.g. DISCORD_GUILD_ID) to override it for preview.
  "preview": {
    // The exact registered staging Discord callback; same path as production.
    "DISCORD_REDIRECT_URI": "",

    // Exact staging hostnames, or *.PROJECT.pages.dev for preview branches.
    "ALLOWED_HOSTS": "",

    // Your staging Access team origin and application audience.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUDIENCE": "",

    // Staging status endpoint and approved backend origin.
    "PUBLIC_STATUS_URL": "",
    "KINETIC_ADMIN_ORIGIN": "",

    // Preview verifier service token's exact signed common_name identity.
    // This is an identity, NOT its client secret. Required only for preview.
    "PREVIEW_VERIFY_SERVICE_ID": ""
  }
}
