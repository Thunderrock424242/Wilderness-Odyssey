# Copy this file to .env, then fill it out from top to bottom.
# Discord IDs are long numbers copied with Developer Mode, not channel names.
# Leave optional values blank instead of keeping fake placeholder text.

# 1) Required bot login
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# 2) Central support hub
# SUPPORT_CHANNEL_ID is the public hub channel where /supportpanel should be posted.
# SUPPORT_TEAM_ROLE_ID is the staff/support role to ping on new reports and add to tickets.
# SUPPORT_TICKET_CATEGORY_ID is where private Other Help and crash upload channels will be created.
# DEV_TEAM_ROLE_ID is pinged on crash and bug reports.
SUPPORT_CHANNEL_ID=
SUPPORT_TEAM_ROLE_ID=
DEV_TEAM_ROLE_ID=
SUPPORT_TICKET_CATEGORY_ID=
STAFF_REVIEW_CHANNEL_ID=
STAFF_LOG_CHANNEL_ID=

# 3) Public forum routing, recommended
# Players use the hub buttons. The bot creates forum posts here automatically.
ISSUES_FORUM_CHANNEL_ID=
IDEAS_FORUM_CHANNEL_ID=

# These must match tag names in your Discord forums.
BUG_FORUM_TAG=Bug
BUG_CONFIRMED_FORUM_TAG=Confirmed
BUG_SOLVED_FORUM_TAG=Solved
CRASH_FORUM_TAG=Crash
PERFORMANCE_FORUM_TAG=Performance Issues
FEEDBACK_FORUM_TAG=Feedback
SUGGESTION_FORUM_TAG=Suggestion

# 4) Plain channel fallbacks
# Use these only if you are not using the matching forum above.
BUG_REPORTS_CHANNEL_ID=
CRASH_REPORTS_CHANNEL_ID=
PERFORMANCE_REPORTS_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=

# 5) Report and playtest channels
SPARK_REPORTS_CHANNEL_ID=
PLAYTEST_SESSIONS_CHANNEL_ID=
PLAYTEST_CATEGORY_ID=

# 6) Q&A handoff, optional
# Recommended: create a Discord forum for community Q&A. New posts alert support.
QA_FORUM_CHANNEL_ID=
QA_ALERT_CHANNEL_ID=
QA_ALERT_ROLE_ID=
# Legacy fallback: QA_CHANNEL_IDS can contain several text channel IDs separated by commas.
QA_CHANNEL_IDS=
# Deprecated aliases kept for existing installs. Prefer QA_ALERT_* for new setup.
QA_TEAM_CHANNEL_ID=
QA_TEAM_ROLE_ID=

# 7) Player-facing status text
LATEST_MODPACK_VERSION=0.1.0
RECOMMENDED_JAVA_VERSION=Java 21
RECOMMENDED_RAM=6-8 GB
SUPPORT_CHANNELS=#support
KNOWN_UNSTABLE_FEATURES=Rifts, anomalies, cryo facilities
SERVER_STATUS_LABEL=Server status integration not connected yet

# 8) Optional external playtest policy links
# The bot already shows in-house terms/privacy through playtest gate buttons.
# Fill these only if you also want public web/document copies.
PLAYTEST_TERMS_URL=
PLAYTEST_PRIVACY_URL=

# 9) Minecraft account verification
# Recommended free/easy path: the Minecraft server posts verification results
# into a private Discord relay channel through a Discord webhook.
MINECRAFT_VERIFY_RELAY_CHANNEL_ID=
# Optional but recommended: restrict accepted relay messages to this exact webhook ID.
MINECRAFT_VERIFY_RELAY_WEBHOOK_ID=
# Optional: role the bot adds after a Minecraft account is verified.
MINECRAFT_VERIFIED_ROLE_ID=

# Optional fallback path: enable only when the bot API is reachable by the playtest client.
MINECRAFT_VERIFY_API_ENABLED=false
MINECRAFT_VERIFY_API_HOST=0.0.0.0
MINECRAFT_VERIFY_API_PORT=3000
# Base URL only. The Wilderness Odyssey API mod appends /api/minecraft/verify.
MINECRAFT_VERIFY_PUBLIC_URL=
MINECRAFT_VERIFY_CODE_TTL_MINUTES=15

# 10) Local storage and upload limits
DATABASE_PATH=data/wilderness-oddesy.sqlite
MAX_LOG_BYTES=2097152

# 11) Reliability and observability, optional
# LOG_LEVEL can be trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info
# SENTRY_DSN enables hosted error tracking when set.
SENTRY_DSN=
# METRICS_ENABLED exposes Prometheus metrics on the same host/port as the bot HTTP API.
METRICS_ENABLED=false
METRICS_PATH=/metrics

# 12) GitHub issue sync, optional
# Repository is owner/name, for example WildernessTeam/Wilderness-Odyssey.
# GITHUB_TOKEN is optional for public import, but required for private repos or future write sync.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_KNOWN_ISSUE_LABELS=known issue,known-issue,bug
