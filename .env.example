DISCORD_TOKEN=put-your-bot-token-here
CLIENT_ID=put-your-application-client-id-here
GUILD_ID=put-your-test-server-id-here

BUG_REPORTS_CHANNEL_ID=put-bug-report-channel-id-here
CRASH_REPORTS_CHANNEL_ID=put-crash-report-channel-id-here
FEEDBACK_CHANNEL_ID=put-feedback-channel-id-here
SUGGESTIONS_CHANNEL_ID=put-suggestions-channel-id-here
ISSUES_FORUM_CHANNEL_ID=put-shared-bug-crash-forum-channel-id-here
IDEAS_FORUM_CHANNEL_ID=put-shared-feedback-suggestions-forum-channel-id-here
BUG_FORUM_TAG=Bug
CRASH_FORUM_TAG=Crash
FEEDBACK_FORUM_TAG=Feedback
SUGGESTION_FORUM_TAG=Suggestion
SPARK_REPORTS_CHANNEL_ID=put-spark-reports-channel-id-here
PLAYTEST_SESSIONS_CHANNEL_ID=put-playtest-sessions-channel-id-here
PLAYTEST_CATEGORY_ID=put-public-playtest-category-id-here
STAFF_REVIEW_CHANNEL_ID=put-staff-review-channel-id-here
QA_CHANNEL_IDS=put-qa-channel-id-here, put-another-qa-channel-id-here
QA_TEAM_CHANNEL_ID=put-qa-team-channel-id-here
QA_TEAM_ROLE_ID=put-qa-team-role-id-here

# Optional legacy aliases still supported by the bot.
PERFORMANCE_REPORTS_CHANNEL_ID=put-performance-report-channel-id-here
FEEDBACK_REPORTS_CHANNEL_ID=put-feedback-channel-id-here
STAFF_LOG_CHANNEL_ID=put-staff-log-channel-id-here
SUPPORT_CHANNEL_ID=put-main-support-channel-id-here

LATEST_MODPACK_VERSION=0.1.0
RECOMMENDED_JAVA_VERSION=Java 21
RECOMMENDED_RAM=6-8 GB
SUPPORT_CHANNELS=#support, #bug-reports, #crash-reports
KNOWN_UNSTABLE_FEATURES=Rifts, anomalies, cryo facilities
SERVER_STATUS_LABEL=Server status integration not connected yet
PLAYTEST_TERMS_URL=https://example.com/playtest-terms
PLAYTEST_PRIVACY_URL=https://example.com/privacy
MINECRAFT_VERIFY_API_ENABLED=false
MINECRAFT_VERIFY_API_HOST=0.0.0.0
MINECRAFT_VERIFY_API_PORT=3000
# Base URL only. The Wilderness Odyssey API mod appends /api/minecraft/verify.
MINECRAFT_VERIFY_PUBLIC_URL=https://example.com
MINECRAFT_VERIFY_CODE_TTL_MINUTES=15

DATABASE_PATH=data/wilderness-oddesy.sqlite
MAX_LOG_BYTES=2097152
