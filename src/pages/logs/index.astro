---
import PageHero from '../../components/PageHero.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { SURVIVOR_LOGS } from '../../data/survivorLogs';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Survivor Logs" description="A glimpse of the archive, with survivor stories reserved for discovery in play." canonicalPath="/logs/">
  <PageHero eyebrow="Illustrative survivor fragments" title="Found in the ruins" description="The archive is incomplete. Survivor stories will unfold through exploration." primaryLabel="Recovered lore" primaryHref="/lore/" secondaryLabel="Open gallery" secondaryHref="/gallery/" />
  <section class="section"><div class="shell"><p class="ch-body">Further field notes are reserved for discovery in play.</p></div>
    <div class="shell survivor-grid">
      {SURVIVOR_LOGS.map((log) => (
        <article class:list={['survivor-log', log.locked && 'survivor-log--locked']}>
          <div class="survivor-log__head"><span>{log.id}</span><time>{log.date}</time></div>
          <h2>Survivor: {log.survivor}</h2>
          <p class="survivor-log__body">{log.body}</p>
          <StatusBadge label={log.status} tone={log.tone === 'safe' ? 'safe' : log.tone === 'warn' ? 'warn' : 'danger'} />
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
