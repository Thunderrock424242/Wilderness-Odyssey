---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import TransmissionArchive from '../../components/TransmissionArchive.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterByType, getPublishedTransmissions } from '../../lib/transmissions';

const entries = filterByType(getPublishedTransmissions(await getCollection('transmissions')), 'lore');
---

<BaseLayout title="Recovered Records" description="A spoiler-light introduction to Wilderness Odyssey and its unanswered questions." canonicalPath="/lore/">
  <PageHero eyebrow="Archive fragments" title="Recovered records" description="A few threads to follow. Deeper histories and discoveries are left for your journey." primaryLabel="Survivor logs" primaryHref="/logs/" secondaryLabel="Lore roadmap" secondaryHref="/roadmap/#lore-discovery-layer" />
  <section class="section"><div class="shell"><TransmissionArchive entries={entries} showTypeFilter={false} /></div></section>
</BaseLayout>
