---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import TransmissionArchive from '../../components/TransmissionArchive.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterByType, getPublishedTransmissions } from '../../lib/transmissions';

const entries = filterByType(getPublishedTransmissions(await getCollection('transmissions')), 'lore');
---

<BaseLayout title="Recovered Records" description="Story records: [REDACTED]. Discover the lore in play." canonicalPath="/lore/">
  <PageHero eyebrow="Restricted archive" title="Recovered records" description="[REDACTED] — Story details are reserved for discovery in play." primaryLabel="Survivor logs" primaryHref="/logs/" secondaryLabel="Lore roadmap" secondaryHref="/roadmap/#lore-discovery-layer" />
  <section class="section"><div class="shell"><TransmissionArchive entries={entries} showTypeFilter={false} /></div></section>
</BaseLayout>
