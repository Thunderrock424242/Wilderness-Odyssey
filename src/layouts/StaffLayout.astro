---
import '../styles/operations.css';
import '../styles/workspace.css';
import StaffNavigation from '../components/StaffNavigation.astro';
type Props = { title: string; section: string };
const { title, section } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="color-scheme" content="dark" /><title>{title} | Wilderness Odyssey Staff</title><link rel="icon" href="/images/logo.png" /></head>
<body class="staff"><a class="skip-link" href="#staff-main">Skip to dashboard</a>
<header class="staff-header"><a class="staff-brand" href="/">Wilderness Odyssey<small>Staff administration</small></a><div class="staff-actions"><span data-staff-identity>Verifying staff access…</span><button class="secondary" type="button" data-staff-signout disabled>Sign out</button></div></header>
<div class="staff-shell"><StaffNavigation />
<main id="staff-main" class="staff-main" data-staff-section={section}><p class="ops-kicker">Administration</p><h1>{title}</h1><p class="staff-message" data-staff-message role="status">Checking access. No staff records have been loaded.</p><div class="staff-actions"><button class="secondary" type="button" data-staff-refresh>Refresh dashboard</button><a href="/login/" data-staff-signin hidden>Sign in with Discord</a></div><div data-staff-workspace hidden><slot /></div><noscript><p>JavaScript and an authorized staff session are required to use this dashboard.</p></noscript></main></div>
<script src="../scripts/staff.ts"></script></body></html>
