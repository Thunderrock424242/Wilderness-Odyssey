---
import type { CollectionEntry } from 'astro:content';
import { TRANSMISSION_LABELS } from '../data/site';
import { formatDate } from '../lib/transmissions';
import { tagUrl, transmissionUrl, withBase } from '../lib/urls';
import StatusBadge from './StatusBadge.astro';

type Props = {
  entry: CollectionEntry<'transmissions'>;
  featured?: boolean;
};
const { entry, featured = entry.data.featured } = Astro.props;
const tone = entry.data.type === 'patch' ? 'warn' : entry.data.type === 'lore' ? 'violet' : entry.data.type === 'announcement' ? 'danger' : 'signal';
---

<article class:list={['transmission-card', featured && 'transmission-card--featured']}>
  {entry.data.coverImage && (
    <a class="transmission-card__media" href={transmissionUrl(entry.id)} aria-label={`Read ${entry.data.title}`}>
      <img src={withBase(entry.data.coverImage)} alt="" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="transmission-card__body">
    <div class="transmission-card__meta">
      <StatusBadge label={TRANSMISSION_LABELS[entry.data.type]} tone={tone} />
      <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>
    </div>
    <h2><a href={transmissionUrl(entry.id)}>{entry.data.title}</a></h2>
    <p>{entry.data.description}</p>
    <div class="transmission-card__details">
      <span>By {entry.data.author}</span>
      {entry.data.version && <span>Version {entry.data.version}</span>}
    </div>
    <ul class="tag-list" aria-label="Tags">
      {entry.data.tags.slice(0, 4).map((tag) => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
    </ul>
    <a class="text-link" href={transmissionUrl(entry.id)}>Open transmission <span aria-hidden="true">→</span></a>
  </div>
</article>
