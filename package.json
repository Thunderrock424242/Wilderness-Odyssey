  "version": "0.1.0",
  "description": "Wilderness Oddesy community support and dev help desk bot for Discord.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
