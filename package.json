{
  "name": "wilderness-oddesy-discord-bot",
  "version": "0.1.0",
  "description": "Wilderness Oddesy community support and dev help desk bot for Discord.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "minecraft",
    "modpack",
    "support",
    "wilderness-oddesy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.57.0",
    "discord.js": "^13.17.1",
    "dotenv": "^16.4.7",
    "lru-cache": "^11.5.1",
    "p-queue": "^9.3.0",
    "pino": "^10.3.1",
    "present": "^1.0.0",
    "prom-client": "^15.1.3",
    "scripts": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
